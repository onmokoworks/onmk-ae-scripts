<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0"
    ExtensionBundleId="com.onmk.animationpresets"
    ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="onmk Animation Presets"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.onmk.animationpresets.viewer" Version="1.0.0"/>
    <Extension Id="com.onmk.animationpresets.save" Version="1.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList><Host Name="AEFT" Version="[13.0,99.9]"/></HostList>
    <LocaleList><Locale Code="All"/></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="9.0"/></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.onmk.animationpresets.viewer">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/viewer.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type><Menu>Preset Viewer</Menu>
          <Geometry><Size><Height>420</Height><Width>360</Width></Size><MinSize><Height>220</Height><Width>240</Width></MinSize></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.onmk.animationpresets.save">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/save.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type><Menu>Preset Save</Menu>
          <Geometry><Size><Height>260</Height><Width>320</Width></Size><MinSize><Height>170</Height><Width>220</Width></MinSize></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
